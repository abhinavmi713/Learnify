# Learnify AI service (course-grounded Q&A). Copy to .env and fill in.
PORT=5001
LOG_LEVEL=info

# Same value as INTERNAL_API_TOKEN in server/.env (at least 24 characters).
INTERNAL_API_TOKEN=
# The main API's internal routes, used to read course content for indexing.
API_INTERNAL_URL=http://localhost:4000/api/v1/internal

GEMINI_API_KEY=
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768
# GEN_MODEL=gemini-3.6-flash

QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=course_chunks

# Optional: consume course.content_changed events to re-index automatically.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Retrieval tuning; run `npm run eval` before changing.
# TOP_K=6
# MIN_SCORE=0.6
