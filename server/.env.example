# ───────────── Core ─────────────
NODE_ENV=development            # set to "production" when deployed
PORT=4000
# Frontend origin(s) allowed to call this API (comma-separated, no trailing slash)
CLIENT_URL=http://localhost:3000
# Behind a reverse proxy / load balancer set the number of proxy hops (usually 1)
# so rate limiting sees real client IPs. Leave unset when NOT behind a proxy.
# TRUST_PROXY=1
LOG_LEVEL=info

# ───────────── Secrets ─────────────
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ───────────── Database ─────────────
MONGODB_URL=mongodb://127.0.0.1:27017/learnify

# ───────────── Email (any SMTP provider: Gmail, Amazon SES, Resend, Postmark…) ─────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# MAIL_SECURE=true              # implicit TLS (port 465)
# MAIL_FROM="Learnify <no-reply@yourdomain.com>"

# ───────────── Payments (Razorpay) ─────────────
RAZORPAY_KEY=                   # rzp_test_… locally, rzp_live_… in production
RAZORPAY_SECRET=
# Dashboard -> Webhooks -> add  https://<your-api>/api/v1/payment/webhook
# for the payment.captured event, and put its secret here. Without it, a student
# who pays and closes the tab before returning is charged but not enrolled.
RAZORPAY_WEBHOOK_SECRET=

# ───────────── Media (Cloudinary) ─────────────
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=Learnify
# Previous upload folders whose existing videos should still be accepted
# (comma-separated). Move old assets with: node scripts/migrateCloudinaryFolder.js
# LEGACY_FOLDER_NAMES=CodeHelp

# ───────────── AI assistant (Google Gemini) ─────────────
GEMINI_API_KEY=

# ───────────── Optional ─────────────
# SENTRY_DSN=                   # enables server error tracking when set
# BACKUP_DIR=./backups          # used by `npm run backup`
# BACKUP_RETENTION_DAYS=14

# ───────────── Infrastructure (docker compose up -d) ─────────────
# Leave these unset to run without Docker: the app falls back to in-process
# equivalents (memory cache, inline email). Mongo runs as a replica set on 27018
# so multi-document transactions work.
# MONGODB_URL=mongodb://127.0.0.1:27018/learnify?directConnection=true
# REDIS_URL=redis://127.0.0.1:6379
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
# QDRANT_URL=http://127.0.0.1:6333
# Run the background consumers inside the API process. Default: on locally when
# RABBITMQ_URL is set, off in production (run `npm run worker` instead).
# RUN_WORKER_IN_API=0
# Set to 0 on a worker that should not also publish the outbox.
# OUTBOX_RELAY=1

# Course AI assistant (ai-service/). Without these the chatbot answers without
# course retrieval. INTERNAL_API_TOKEN must match ai-service/.env (24+ chars),
# e.g. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# AI_SERVICE_URL=http://localhost:5001
# INTERNAL_API_TOKEN=

# Sessions: access token lifetime, refresh token lifetime (rotated on every use)
# and the hard limit for one login, however often it is refreshed.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=7
# SESSION_MAX_DAYS=30

# Encrypts secrets at rest (two-factor authentication seeds). 64 hex chars:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable: changing it disables existing 2FA setups.
# ENCRYPTION_KEY=

# Course search (Elasticsearch). Unset = MongoDB search. After first start run
# `npm run search:reindex`; afterwards course events keep the index current.
# ELASTICSEARCH_URL=http://127.0.0.1:9200
# Hosted: an API key (Elastic Cloud), or https://user:password@host in the URL (Bonsai).
# ELASTICSEARCH_API_KEY=

# Observability. /metrics is open outside production; in production set
# METRICS_TOKEN and configure Prometheus with it (bearer token).
# METRICS_TOKEN=
# WORKER_METRICS_PORT=9464
# Tracing (OpenTelemetry, OTLP over HTTP), e.g. the Jaeger container:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Webhooks: allow http://localhost URLs for local testing (never in production;
# private and internal addresses are always refused there).
# ALLOW_PRIVATE_WEBHOOK_URLS=1
