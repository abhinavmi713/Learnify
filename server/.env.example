# ───────────── Core ─────────────
NODE_ENV=development            # set to "production" when deployed
PORT=4000
# Frontend origin(s) allowed to call this API (comma-separated, no trailing slash)
CLIENT_URL=http://localhost:3000
# Behind a reverse proxy / load balancer set the number of proxy hops (usually 1)
# so rate limiting sees real client IPs. Leave unset when NOT behind a proxy.
# TRUST_PROXY=1
LOG_LEVEL=info

# ───────────── Secrets ─────────────
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ───────────── Database ─────────────
MONGODB_URL=mongodb://127.0.0.1:27017/learnify

# ───────────── Email (any SMTP provider: Gmail, Amazon SES, Resend, Postmark…) ─────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# MAIL_SECURE=true              # implicit TLS (port 465)
# MAIL_FROM="Learnify <no-reply@yourdomain.com>"

# ───────────── Payments (Razorpay) ─────────────
RAZORPAY_KEY=                   # rzp_test_… locally, rzp_live_… in production
RAZORPAY_SECRET=
# Dashboard -> Webhooks -> add  https://<your-api>/api/v1/payment/webhook
# for the payment.captured event, and put its secret here. Without it, a student
# who pays and closes the tab before returning is charged but not enrolled.
RAZORPAY_WEBHOOK_SECRET=

# ───────────── Media (Cloudinary) ─────────────
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=Learnify

# ───────────── AI assistant (Google Gemini) ─────────────
GEMINI_API_KEY=

# ───────────── Optional ─────────────
# SENTRY_DSN=                   # enables server error tracking when set
# BACKUP_DIR=./backups          # used by `npm run backup`
# BACKUP_RETENTION_DAYS=14

# ───────────── Infrastructure (docker compose up -d) ─────────────
# Leave these unset to run without Docker: the app falls back to in-process
# equivalents (memory cache, inline email). Mongo runs as a replica set on 27018
# so multi-document transactions work.
# MONGODB_URL=mongodb://127.0.0.1:27018/learnify?directConnection=true
# REDIS_URL=redis://127.0.0.1:6379
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
# QDRANT_URL=http://127.0.0.1:6333
# Run the background consumers inside the API process. Default: on locally when
# RABBITMQ_URL is set, off in production (run `npm run worker` instead).
# RUN_WORKER_IN_API=0
# Set to 0 on a worker that should not also publish the outbox.
# OUTBOX_RELAY=1
